# Copia este fichero a .env y rellenalo. NUNCA lo subas a git. Cada persona tiene su propio .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PASSWORD=            # debe coincidir con POSTGRES_PASSWORD
JWT_SECRET=             # cadena larga y aleatoria: openssl rand -hex 32
SESSION_TTL_HOURS=24
PUBLIC_BASE_URL=https://localhost:8443

# Correo real (solo se usa con `make up`). Con Gmail: contraseña de aplicacion de 16 letras.
# Con `make dev` estos valores se ignoran: el correo va a Mailpit (http://localhost:8025).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Login con 42. Redirect URI en la intra: https://localhost:8443/api/auth/42/callback
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
